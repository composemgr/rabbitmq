# RabbitMQ — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=rabbitmq.example.com
BASE_DOMAIN_NAME=example.com

# Broker superuser created on first start
RABBITMQ_DEFAULT_VHOST=/
DB_ADMIN_NAME=admin
DB_ADMIN_PASS=replace-with-a-random-password
